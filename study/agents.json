    "setup": [
      "pip install -q -U pip",
      "pip install -q -e .",
      "pip install -q --group dev"
    ]
  },
  {
    "name": "fastmcp",
    "url": "https://github.com/PrefectHQ/fastmcp",
    "runner": "python",
    "history": false,
